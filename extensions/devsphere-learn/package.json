{
  "name": "devsphere-learn",
  "displayName": "DevPilot Guide",
  "description": "Guides each step of a DevPilot lab in a side panel. Talks only to the DevPilot app on this computer.",
  "version": "0.3.2",
  "private": true,
  "publisher": "devpilot",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.144.0",
    "node": ">=20"
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "workspaceContains:.devsphere/lab.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder the guide is read-only and Check my work is turned off."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "devpilot",
          "title": "DevPilot Guide",
          "icon": "media/guide.svg"
        }
      ]
    },
    "views": {
      "devpilot": [
        {
          "type": "webview",
          "id": "devpilot.guide",
          "name": "Lab guide"
        }
      ]
    },
    "commands": [
      {
        "command": "devsphere.openGuide",
        "title": "DevPilot: Open Lab Guide"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.1",
    "typescript": "5.6.3"
  }
}

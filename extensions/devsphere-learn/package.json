{
  "name": "devsphere-learn",
  "displayName": "BuildLoop Guide",
  "description": "Guides each step of a BuildLoop lab in a side panel. Talks only to the BuildLoop app on this computer.",
  "version": "0.1.0",
  "private": true,
  "publisher": "buildloop",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "workspaceContains:.devsphere/lab.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder the guide is read-only and Check my work is turned off."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "devsphere.openGuide",
        "title": "BuildLoop: Open Lab Guide"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.1",
    "typescript": "5.6.3"
  }
}

  "components": {
    "schemas": {
      "Consent": {
        "properties": {
          "notice_version": {
            "type": "string",
            "title": "Notice Version"
          },
          "age_check_passed": {
            "type": "boolean",
            "title": "Age Check Passed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "notice_version",
          "age_check_passed"
        ],
        "title": "Consent"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "default": {}
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "type"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewAttempt": {
        "properties": {
          "lab_id": {
            "type": "string",
            "title": "Lab Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lab_id"
        ],
        "title": "NewAttempt"
      },
      "Profile": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Display Name"
          },
          "college": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "College"
          },
          "course": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interests",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "Profile"
      },
      "SignedResult": {
        "properties": {
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "signature_b64": {
            "type": "string",
            "title": "Signature B64"
          }
        },
        "type": "object",
        "required": [
          "payload",
          "signature_b64"
        ],
        "title": "SignedResult"
      },
      "TutorMessage": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "title": "Attempt Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "title": "Question"
          },
          "level": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Level"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "question",
          "level"
        ],
        "title": "TutorMessage"
      },
      "ValidationError": {
        "properties": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsphere.example/schemas/lab-manifest-1.json",
  "title": "DevSphere lab manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "difficulty",
    "os",
    "runtimes",
    "workspace",
    "guide",
    "tutor",
    "evaluation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "estimated_minutes": { "type": "integer", "minimum": 5, "maximum": 600 },
    "os": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] }, "minItems": 1 },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "enum": ["code-editor"] }, "language": { "type": "string" } }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "manager": { "enum": ["uv", "venv"] } }
    },
    "guide": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "content_ref"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "content_ref": { "type": "string" },
              "practice_check": { "type": "string" }
            }
          }
        }
      }
    },
    "tutor": {
      "type": "object",
      "required": ["enabled", "max_assistance_level"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_assistance_level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "allowed_context": {
          "type": "array",
          "items": { "enum": ["guide", "selected_files", "task_output"] }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["rubric_version", "evaluator", "max_points", "checks"],
      "additionalProperties": false,
      "properties": {
        "rubric_version": { "type": "integer", "minimum": 1 },
        "evaluator": { "enum": ["pytest"] },
        "max_points": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "points", "visible"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["filesystem", "test", "lint", "choice"] },
              "points": { "type": "integer", "minimum": 0 },
              "visible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "last_verified"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}

{
  "name": "devpilot-web",
  "version": "0.1.0",
  "private": true,
  "description": "The DevPilot landing page (Next.js)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "python3 -m http.server 3100 -d out",
    "typecheck": "tsc --noEmit",
    "deploy": "next build && firebase deploy --only hosting --project devpilot-app",
    "gen:install": "node scripts/make-install-script.mjs",
    "prebuild": "node scripts/make-install-script.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}

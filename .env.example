# Copy to .env for local development. Never commit .env (see .agents/RULES.md).
# Backend
DEVSPHERE_ENV=dev
DATABASE_URL=postgresql+psycopg://devsphere:devsphere@localhost:5432/devsphere
IDENTITY_PROJECT_ID=your-identity-project-id
AI_PROVIDER=stub
AI_PROVIDER_API_KEY=
# Grader (separate project; never share these with the backend)
GRADER_SIGNING_KEY_PATH=./secrets/grader-signing.key
# Desktop
DEVSPHERE_API_URL=http://localhost:8787

# Google sign-in: the secret of the "DevPilot Desktop" OAuth client (devpilot-app). Keep it in .env only.
DEVPILOT_GOOGLE_CLIENT_SECRET=

# Use the hosted API instead of the local one (the app reads this at start-up):
# DEVPILOT_API_URL=https://devpilot-api-664564860639.asia-south1.run.app

# YouTube video search for learning paths: the Secret Manager version that holds the key (read with your gcloud login).
# DEVSPHERE_YOUTUBE_API_KEY_SECRET=projects/devpilot-app/secrets/youtube-api-key/versions/latest
